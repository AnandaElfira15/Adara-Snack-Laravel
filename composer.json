{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "student/adara-snack",
  "type": "project",
  "description": "UTS Web Programming 2 - Adara Snack Inventory & Sales Management System",
  "keywords": ["laravel", "inventory", "sales"],
  "license": "MIT",
  "require": {"php": "^8.2", "laravel/framework": "^12.0", "laravel/tinker": "^2.10"},
  "require-dev": {
    "fakerphp/faker": "^1.23",
    "laravel/pail": "^1.2",
    "mockery/mockery": "^1.6",
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {"psr-4": {"App\\": "app/", "Database\\Factories\\": "database/factories/", "Database\\Seeders\\": "database/seeders/"}},
  "autoload-dev": {"psr-4": {"Tests\\": "tests/"}},
  "scripts": {"test": ["@php artisan test"]},
  "config": {"optimize-autoloader": true, "preferred-install": "dist", "sort-packages": true, "allow-plugins": {"php-http/discovery": true}},
  "minimum-stability": "stable", "prefer-stable": true
}
